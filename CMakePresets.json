{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "LLAMATRON_ORIGINAL_DIR": "$penv{LLAMATRON_ORIGINAL_DIR}"
      }
    },
    {
      "name": "macos-native",
      "displayName": "macOS native (SDL2)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "LLAMATRON_TARGET": "native"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos-app",
      "displayName": "macOS Llamatron.app (self-contained, personal use only)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-app",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LLAMATRON_TARGET": "native",
        "LLAMATRON_MACOS_BUNDLE": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "linux-native",
      "displayName": "Linux native (SDL2)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "LLAMATRON_TARGET": "native"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "ci-native",
      "displayName": "CI check, native: compiler warnings are errors (build-ci)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "LLAMATRON_TARGET": "native",
        "LLAMATRON_WERROR": "ON"
      }
    },
    {
      "name": "ci-web",
      "displayName": "CI check, browser: compiler warnings are errors (build-ci-web) - configure via emcmake",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-ci-web",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LLAMATRON_TARGET": "web",
        "LLAMATRON_WERROR": "ON"
      }
    },
    {
      "name": "web-emscripten",
      "displayName": "Browser (Emscripten, SDL2 port) - configure via emcmake",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-web",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LLAMATRON_TARGET": "web"
      }
    }
  ],
  "buildPresets": [
    { "name": "macos-native", "configurePreset": "macos-native" },
    { "name": "macos-app", "configurePreset": "macos-app", "targets": ["llamatron_macos_app"] },
    { "name": "linux-native", "configurePreset": "linux-native" },
    { "name": "web-emscripten", "configurePreset": "web-emscripten" },
    { "name": "ci-native", "configurePreset": "ci-native" },
    { "name": "ci-web", "configurePreset": "ci-web" }
  ],
  "testPresets": [
    { "name": "macos-native", "configurePreset": "macos-native", "output": { "outputOnFailure": true } },
    { "name": "macos-app", "configurePreset": "macos-app", "output": { "outputOnFailure": true },
      "filter": { "include": { "name": "^(macos_app_|app_icon_from_title$)" } } },
    { "name": "linux-native", "configurePreset": "linux-native", "output": { "outputOnFailure": true } },
    { "name": "web-emscripten", "configurePreset": "web-emscripten", "output": { "outputOnFailure": true } },
    { "name": "ci-native", "configurePreset": "ci-native", "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "dosbox" } } }
  ],
  "workflowPresets": [
    {
      "name": "ci-native",
      "displayName": "Build with warnings as errors and run the tests (build-ci)",
      "steps": [
        { "type": "configure", "name": "ci-native" },
        { "type": "build", "name": "ci-native" },
        { "type": "test", "name": "ci-native" }
      ]
    },
    {
      "name": "macos-app",
      "displayName": "Build and check build-app/Llamatron.app",
      "steps": [
        { "type": "configure", "name": "macos-app" },
        { "type": "build", "name": "macos-app" },
        { "type": "test", "name": "macos-app" }
      ]
    }
  ]
}
