# clang-tidy checks agreed in the code-health sweep (2026-10-19, clang-tidy 23.1.3).
# Left out on purpose: signed-bitwise (the port works on the original's signed 16-bit words),
# implicit-widening-of-multiplication-result, signed-char-misuse (sign extension of the
# original's bytes is intended), assignment-in-if-condition / -selection-statement and
# inc-dec-in-conditions (C idioms; && and || are sequenced), easily-swappable-parameters,
# narrowing-conversions (-Wconversion covers it), the analyzer's opt-in checks.
# Run: clang-tidy -p <build dir> <file.c> (on macOS add --extra-arg=-isysroot$(xcrun --show-sdk-path)
# for a clang-tidy outside Xcode).
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-signed-bitwise,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-assignment-in-if-condition,
  -bugprone-assignment-in-selection-statement,
  -bugprone-signed-char-misuse,
  -bugprone-inc-dec-in-conditions,
  -clang-analyzer-optin.*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  readability-misleading-indentation,
  readability-duplicate-include,
  readability-inconsistent-declaration-parameter-name,
  readability-redundant-declaration,
  readability-non-const-parameter,
  readability-else-after-return,
  readability-redundant-control-flow
WarningsAsErrors: ''
HeaderFilterRegex: '(src|tools|tests|cmake)/'
